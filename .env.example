# AI Provider: gemini (Free, recommended), groq (Free, ultra-fast), ollama (Free, offline), or anthropic
AI_PROVIDER=gemini

# Google Gemini API Key (100% Free at https://aistudio.google.com/apikey - No credit card required)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (100% Free at https://console.groq.com/keys - Ultra-fast Llama 3.3 / DeepSeek)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude API Key (Paid at https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Search Configuration
ENABLE_WEB_SEARCH=true

# Database Path
DB_PATH=myai.db
